    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\":\"object\",\"properties\":{\"has_private_event_space\":{\"type\":\"boolean\",\"description\":\"True if the site mentions private dining rooms, banquet rooms, event rooms or dedicated event space\"},\"max_group_capacity\":{\"type\":\"number\",\"description\":\"Largest seated group capacity stated for any event space, or 0 if none is stated\"},\"has_events_menu_or_buyout\":{\"type\":\"boolean\",\"description\":\"True if the site has an events or catering menu, event packages, or full buyout packages\"},\"has_inquiry_form_or_event_contact\":{\"type\":\"boolean\",\"description\":\"True if there is an event inquiry form or an event contact email or phone\"},\"relies_on_manual_quotes\":{\"type\":\"boolean\",\"description\":\"True if events are booked through PDF packets, a generic contact form or generic email with no instant online booking or pricing\"},\"is_fast_casual_only\":{\"type\":\"boolean\",\"description\":\"True if the business is only a counter-serve or fast casual brand with no event hosting\"},\"primary_pain_point\":{\"type\":\"string\",\"description\":\"Specific operational bottleneck observed on their site. Do not write generic slogans.\"},\"icebreaker_angle\":{\"type\":\"string\",\"description\":\"A 1-2 sentence B2B cold email opener addressed to the venue Event Director following our formula. Must reference a real venue detail and their manual inquiry friction. NEVER write ads for diners.\"},\"reasoning\":{\"type\":\"string\",\"description\":\"One or two sentences naming the evidence for the facts above\"}},\"required\":[\"has_private_event_space\",\"max_group_capacity\",\"has_events_menu_or_buyout\",\"has_inquiry_form_or_event_contact\",\"relies_on_manual_quotes\",\"is_fast_casual_only\",\"primary_pain_point\",\"icebreaker_angle\",\"reasoning\"]}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1256,
        328
      ],
      "id": "210af098-e2f4-4282-97ce-447e1008b871",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const rawText = $input.item.json.data || $input.item.json.body || '';\n\n// Keywords relevant to private dining and high-ticket catering\nconst eventKeywords = [\n  'private', 'event', 'dining', 'catering', 'banquet', 'buyout',\n  'room', 'capacity', 'guest', 'party', 'reception', 'corporate',\n  'inquiry', 'contact', 'book', 'reserve', 'space', 'package', 'pdf'\n];\n\n// Split text by paragraphs\nconst paragraphs = rawText.split(/\\n\\s*\\n/);\n\nconst relevantSections = [];\nlet totalChars = 0;\n\nfor (const p of paragraphs) {\n  const lower = p.toLowerCase();\n  const hasKeyword = eventKeywords.some(kw => lower.includes(kw));\n  const isJunk = lower.includes('cookie') || lower.includes('privacy policy') || lower.includes('all rights reserved');\n\n  if (hasKeyword && !isJunk) {\n    relevantSections.push(p.trim());\n    totalChars += p.length;\n    if (totalChars > 2500) break; // Hard cap at ~2,500 chars (approx. 500-600 tokens)\n  }\n}\n\n// Fallback to first 1,500 characters if no specific event keywords were mentioned\nconst distilledText = relevantSections.length > 0 \n  ? relevantSections.join('\\n\\n') \n  : rawText.substring(0, 1500);\n\nreturn {\n  json: {\n    ...$input.item.json,\n    distilled_content: distilledText,\n    original_char_count: rawText.length,\n    distilled_char_count: distilledText.length\n  }\n};"
      },
