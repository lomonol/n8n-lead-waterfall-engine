    {
      "id": "b01a10ec-01b6-4ece-a8ae-108e7e8c6372",
      "name": "Normalize Contact Info",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $input.item.json;\nconst tomba = (j.data && Array.isArray(j.data.emails)) ? j.data.emails : null;\nconst rank = (e) => {\n  const t = ((e.position || '') + ' ' + (e.department || '')).toLowerCase();\n  let s = Number(e.score || 0) / 100;\n  if (/event|banquet|catering|private dining|sales|marketing|general manager|owner|director|manager/.test(t)) s += 2;\n  if (e.type === 'generic') s += 0.5;\n  return s;\n};\nlet first_name = '', last_name = '', full_name = '', email = '', job_title = '', enrichment_source = 'apify';\nif (tomba && tomba.length) {\n  const best = [...tomba].sort((a, b) => rank(b) - rank(a))[0];\n  first_name = best.first_name || '';\n  last_name = best.last_name || '';\n  full_name = (best.full_name || (first_name + ' ' + last_name)).trim();\n  email = String(best.email || '').trim().toLowerCase();\n  job_title = best.position || '';\n  enrichment_source = 'tomba';\n} else {\n  const em = Array.isArray(j.emails) ? ((j.emails[0] && j.emails[0].value) || j.emails[0]) : '';\n  email = String(em || '').trim().toLowerCase();\n}\nreturn { json: { first_name, last_name, full_name, email, job_title, enrichment_source } };"
      }
