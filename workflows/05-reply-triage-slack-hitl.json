      "position": [
        160,
        0
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nlet from_email = '';\nif (item.from && typeof item.from === 'object' && item.from.value && item.from.value[0]) {\n  from_email = item.from.value[0].address;\n} else if (item.from && typeof item.from === 'object' && item.from.text) {\n  from_email = item.from.text;\n} else if (typeof item.from === 'string') {\n  from_email = item.from;\n}\n\nlet subject = item.subject || '';\nlet body_text = item.text || item.snippet || '';\n\nif (!from_email && item.body) {\n  from_email = item.body?.data?.from || item.body?.from || '';\n  subject = item.body?.data?.subject || item.body?.subject || '';\n  body_text = item.body?.data?.text || item.body?.reply_text || item.body?.text || '';\n}\n\nreturn [{\n  json: { from_email, subject, body_text }\n}];"
      }
    },
