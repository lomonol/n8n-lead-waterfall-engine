    {
      "id": "02f7d3eb-b4fc-43f4-80db-2b3226c17a1e",
      "name": "Apply Daily Cap and Restore Batch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        -96
      ],
      "parameters": {
        "jsCode": "const DAILY_CAP = 5;\nconst contacts = $('Fetch Verified Contacts').all();\nconst idx = (i) => (typeof i.pairedItem === 'number' ? i.pairedItem : i.pairedItem.item);\nconst picked = $('Filter Suppressed Contacts').all().map(i => contacts[idx(i)].json);\nconst sd = $getWorkflowStaticData('global');\nconst today = new Date().toISOString().slice(0, 10);\nif (sd.day !== today) { sd.day = today; sd.sent = 0; }\nconst room = Math.max(0, DAILY_CAP - sd.sent);\nconst batch = picked.slice(0, room);\nsd.sent += batch.length;\nreturn batch.map(json => ({ json }));"
      }
    },
    {
      "id": "5c58d81a-cd37-4eba-ae4d-d3d5995f41d7",
      "name": "Fetch Suppression List",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        448,
        0
      ],
      "parameters": {
        "operation": "getAll",
        "tableId": "outbound_suppression",
        "returnAll": true
