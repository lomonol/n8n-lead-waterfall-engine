      "executeOnce": true
    },
    {
      "id": "7db8f07c-e44b-4da6-b7ba-28539dbf43ce",
      "name": "Filter Suppressed Contacts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const contacts = $('Fetch Verified Contacts').all();\nconst sup = new Set($input.all().map(i => String(i.json.email_or_domain || '').toLowerCase()).filter(Boolean));\nconst out = [];\ncontacts.forEach((c, idx) => {\n  const e = String(c.json.email || '').toLowerCase();\n  const d = e.split('@')[1] || '';\n  if (!sup.has(e) && !sup.has(d)) out.push({ json: c.json, pairedItem: { item: idx } });\n});\nreturn out;"
      }
    }
