      "name": "Build Approval Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ],
      "parameters": {
        "jsCode": "const contacts = $('Fetch Verified Contacts').all();\nconst idx = (i) => (typeof i.pairedItem === 'number' ? i.pairedItem : i.pairedItem.item);\nconst ok = $input.all().map(i => contacts[idx(i)].json);\nconst lines = ok.map(c => `- ${c.first_name || ''} ${c.last_name || ''} <${c.email}>`.replace('-  ', '- '));\nreturn [{ json: { count: ok.length, summary: lines.join('\\n') } }];"
      }
    },
